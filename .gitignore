# Python bytecode, cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# Virtual Environments
.venv/
venv/
ENV/
env/
*.venv/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# IDE & OS Artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Video & Data Files (directories kept tracked via .gitkeep)
data/videos/*
!data/videos/.gitkeep
data/face_gallery/*
!data/face_gallery/.gitkeep
*.mp4
*.avi
*.mov
*.mkv
*.flv
*.wmv
*.h264
*.hevc

# Deep Learning Models & Embeddings (keep directory tracked via .gitkeep)
models/*
!models/.gitkeep
*.pt
*.pth
*.onnx
*.engine
*.bin
*.safetensors
*.tflite
*.h5
*.ckpt
*.weights
*.npy
*.npz
*.pkl
*.pickle

# Local Databases & Cache
*.sqlite
*.sqlite3
*.db
*.rdb
*.pgdump
.cache/

# Logs & Temporary Files
*.log
tmp/
temp/
scratch/
data/debug/
