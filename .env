# VISION System Environment Variables
APP_NAME=VISION
API_PORT=8000
ENVIRONMENT=development

# Database Configuration
POSTGRES_USER=vision_user
POSTGRES_PASSWORD=vision_pass
POSTGRES_DB=vision_db
POSTGRES_URL=postgresql://vision_user:vision_pass@localhost:5432/vision_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Model Paths
YOLO_MODEL_PATH=models/yolov8n.pt
SCRFD_MODEL_PATH=models/scrfd.onnx
ARCFACE_MODEL_PATH=models/arcface.onnx
